# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real API URLs/keys here.

# Laravel backend base URL. Use your machine's LAN IP (not localhost) when testing
# on a physical device, since the device can't reach your computer's localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Stripe PUBLISHABLE key only (safe to ship in the app). Never put the secret key here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
